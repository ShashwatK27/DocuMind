# Copy to .env and adjust as needed. All settings are optional; the defaults are
# the configuration selected by the experiments (see decision.md).

# --- Vector store ---
# Set a URL to use a Qdrant server (docker-compose sets this automatically).
# Leave unset to use a local on-disk store at DOCUMIND_QDRANT_PATH.
# DOCUMIND_QDRANT_URL=http://localhost:6333
# DOCUMIND_QDRANT_PATH=qdrant_storage
# DOCUMIND_QDRANT_COLLECTION=documind

# --- Generation (Ollama) ---
# DOCUMIND_OLLAMA_BASE_URL=http://localhost:11434
# DOCUMIND_OLLAMA_MODEL=llama3.2:3b
# DOCUMIND_GENERATION_ENABLED=true

# --- Pipeline (override only to experiment; defaults are the selected config) ---
# DOCUMIND_CHUNK_SIZE=500
# DOCUMIND_CHUNK_OVERLAP=150
# DOCUMIND_ENRICH_METADATA=true
# DOCUMIND_RETRIEVAL_TOP_K=20
# DOCUMIND_RERANKER_TOP_K=5
# DOCUMIND_MAX_CHUNKS_PER_PAGE=1
# DOCUMIND_FUSION_ALPHA=0.15

# --- Observability (optional Langfuse tracing) ---
# Set BOTH keys to enable per-stage tracing of /query; unset = no-op (D-20).
# These are NOT prefixed with DOCUMIND_ (the Langfuse SDK reads them directly).
# LANGFUSE_PUBLIC_KEY=pk-lf-...
# LANGFUSE_SECRET_KEY=sk-lf-...
# LANGFUSE_HOST=https://cloud.langfuse.com
